# ─── Runtime ─────────────────────────────────────────────────
APP_ENV=development
PORT=9099
URL_PUBLIC=http://localhost:9099

# ─── Database (system schema; tenant schemas are created on the fly) ──
DATABASE_URL=postgres://synapta:synapta_pass@localhost:5432/synapta?sslmode=disable

# ─── Security ────────────────────────────────────────────────
# Required in production: JWT signing secret (any long random string).
JWT_SECRET=dev_only_jwt_secret_change_me
# Required in production: EXACTLY 32 chars — AES-256 key for tenant credentials.
ENCRYPTION_KEY=dev_only_32_byte_encryption_key!!
# Required in production: comma-separated list, '*' not allowed.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Platform superadmin (system schema) ─────────────────────
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=superadmin_pass_123
SUPER_ADMIN_NAME=
SUPER_ADMIN_SURNAME=
SUPER_ADMIN_USER_NAME=
SUPER_ADMIN_EMAIL=

# ─── Storage ─────────────────────────────────────────────────
UPLOAD_DIR=./uploads
OUTPUTS_DIR=./outputs

# ─── DB pool ─────────────────────────────────────────────────
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1800

# ─── Web Push (VAPID) — optional ─────────────────────────────
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:admin@synapta.local
