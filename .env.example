# ─── Runtime ─────────────────────────────────────────────────
APP_ENV=development
PORT=8099
URL_PUBLIC=http://localhost:8099
# Observability (GlitchTip / Sentry error tracking)
GLITCHTIP_DSN=

# ─── Database (system schema; tenant schemas are created on the fly) ──
DATABASE_URL=postgres://synapta:synapta_pass@localhost:5432/synapta?sslmode=disable

# ─── Security ────────────────────────────────────────────────
# Required in production: JWT signing secret (any long random string).
JWT_SECRET=dev_only_jwt_secret_change_me
# Required in production: EXACTLY 32 chars — AES-256 key for tenant credentials.
ENCRYPTION_KEY=dev_only_32_byte_encryption_key!!
# Required in production: comma-separated list, '*' not allowed.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:4200,http://localhost:3000

# ─── Platform superadmin (system schema) ─────────────────────
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=superadmin_pass_123
SUPER_ADMIN_NAME=
SUPER_ADMIN_SURNAME=
SUPER_ADMIN_USER_NAME=
SUPER_ADMIN_EMAIL=

# ─── Storage ─────────────────────────────────────────────────
UPLOAD_DIR=./uploads
OUTPUTS_DIR=./outputs

# ─── Uploads ─────────────────────────────────────────────────
# Cap for direct uploads in bytes (default 10 MiB). Advisory for the PUT:
# S3 does not enforce size on a plain presigned PUT.
MAX_UPLOAD_BYTES=10485760

# Object storage (MinIO/S3) is configured PER TENANT from the API
# (PUT /api/v1/files/storage, tenant admin): endpoint, bucket, region and
# credentials, encrypted at rest in the tenant schema. There is no global
# bucket in this file: a tenant without its own bucket keeps storing files on
# the local disk under UPLOAD_DIR. The bucket needs CORS allowing
# PUT + Content-Type from the front's origin, plus a public-read policy (or a
# CDN exposed as public_base) to serve the uploaded files.

# Allow tenant buckets on loopback/private addresses (development MinIO).
# Off in production: the server connects to whatever endpoint a tenant admin
# saves, so private targets would be an SSRF probe into the internal network.
STORAGE_ALLOW_PRIVATE_ENDPOINTS=false

# ─── DB pool ─────────────────────────────────────────────────
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1800

# ─── Inference worker (downloaded models) ────────────────────
# brain-master inference worker (Python, gRPC). Empty = no downloaded models.
# Plain host:port for local/VM workers, tls://host:port for cloudflared tunnels.
# Examples: 127.0.0.1:50051 | tls://trycloudflare.com
BM_WORKER_ADDR=
# Per-call timeout for worker reads (catalog/status). Reads are always live:
# nothing is cached on the Synapta side.
BM_WORKER_TIMEOUT_SECONDS=6

# ─── Web Push (VAPID) — optional ─────────────────────────────
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:admin@synapta.local
