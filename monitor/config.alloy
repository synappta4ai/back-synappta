// 1. Receptor de Logs OTLP (Faro) directo a Loki
loki.source.otlp "faro_logs" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  forward_to = [loki.write.local_loki.receiver]
}

// 2. Receptor de Métricas OTLP (Faro)
otelcol.receiver.otlp "faro_metrics" {
  http {
    endpoint = "0.0.0.0:4319" // Cambiado a 4319 para evitar conflicto con el receptor de logs
  }
  output {
    metrics = [prometheus.remote_write.local_prometheus.receiver]
  }
}

// 3. Enviar Logs a Loki
loki.write "local_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// 4. Enviar Métricas a Prometheus
prometheus.remote_write "local_prometheus" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}
