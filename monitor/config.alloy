// 1. Recibir datos OTLP (Faro)
otelcol.receiver.otlp "faro" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  output {
    metrics = [prometheus.remote_write.local_prometheus.receiver]
    logs    = [otelcol.processor.logs.faro_to_loki.input]
  }
}

// 2. Convertir Logs de OTLP a formato de Loki
otelcol.processor.logs "faro_to_loki" {
  output {
    logs = [loki.write.local_loki.receiver]
  }
}

// 3. Enviar Logs a Loki
loki.write "local_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// 4. Enviar Métricas a Prometheus
prometheus.remote_write "local_prometheus" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}
